# Local development defaults to file:prisma/dev.db when these are omitted.
# Vercel's Turso integration creates both variables automatically.
TURSO_DATABASE_URL="file:prisma/dev.db"
TURSO_AUTH_TOKEN=""

AUTH_SECRET="change-this-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"
NEXT_PUBLIC_SITE_URL="https://www.techsastra.com"

# Optional: from Google Search Console
# GOOGLE_SITE_VERIFICATION="your-verification-code"

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
