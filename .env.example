# Local MySQL example. On Vercel, use Railway's public TCP proxy URL,
# never a *.railway.internal hostname.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"
AUTH_SECRET="change-this-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-password"
NEXT_PUBLIC_SITE_URL="https://techsastra.com"
# Optional: from Google Search Console
# GOOGLE_SITE_VERIFICATION="your-verification-code"

# Cloudinary (image storage — replaces the local public/uploads disk, which cannot persist on Vercel)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
