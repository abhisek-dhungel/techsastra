{
  "name": "techsastra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:deploy && next build",
    "build:app": "next build",
    "start": "node .next/standalone/server.js",
    "start:cpanel": "node server.js",
    "pack:cpanel": "bash scripts/build-deploy.sh",
    "lint": "eslint",
    "db:deploy": "node scripts/deploy-database.mjs",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "backfill:images": "node --import tsx scripts/backfill-cloudinary.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.0",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
